# Local development. Copy to backend/.env and replace placeholders.
DEBUG=true
SECRET_KEY=replace-with-a-long-random-secret
MONGODB_URI=mongodb://localhost:27017
DB_NAME=LuminAI_db
CHAT_DB=chats
BLOG_DB=blogs
NOTE_DB=notes
USER_DB=users
DOCUMENTS_DB=documents
OPENROUTER_API_KEY=
TAVILY_API_KEY=
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Production: use a persistent remote Qdrant service and set both values.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=documents_collection
# Comma-separated, exact browser origins (no trailing slash).
FRONTEND_ORIGINS=
